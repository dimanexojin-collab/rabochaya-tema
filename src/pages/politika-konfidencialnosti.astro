---
import Page from '../layouts/Page.astro';
import TodoNote from '../components/TodoNote.astro';
import { SITE, isTodo, fullAddress } from '../config/site.ts';
import { fitDescription } from '../lib/seo.ts';

const description = fitDescription(`Политика конфиденциальности сайта «${SITE.name}» (${SITE.legal.entity}): сайт не собирает персональные данные, заявки отправляются из вашего почтового клиента.`);
---
<Page title="Политика конфиденциальности" description={description} h1="Политика конфиденциальности" crumbs={[{ name: 'Политика конфиденциальности', href: '/politika-konfidencialnosti/' }]} cta={false}>
  <div class="prose">
    <p>Оператор сайта — {SITE.legal.entity}, ИНН {SITE.legal.inn}{isTodo(SITE.legal.ogrn) ? '' : `, ОГРН ${SITE.legal.ogrn}`}. Адрес: {fullAddress()}. Юридический адрес: {isTodo(SITE.legal.legalAddress) ? <TodoNote what="юридический адрес" /> : SITE.legal.legalAddress}.</p>
    <h2>Какие данные мы получаем</h2>
    <p>Сайт не использует формы с отправкой на сервер, cookies для отслеживания и счётчики посещаемости. Форма заявки лишь собирает текст письма в вашем браузере и открывает ваш почтовый клиент — данные уходят нам только когда вы сами отправите письмо на {SITE.email}.</p>
    <p>Из письма или звонка мы получаем то, что вы сообщили: имя, телефон или e-mail, название и реквизиты организации, сведения о заказе.</p>
    <h2>Зачем</h2>
    <p>Чтобы ответить на запрос, подготовить счёт и выполнить заказ. Данные не передаются третьим лицам, кроме случаев, предусмотренных законом, и не используются для рассылок без вашего согласия.</p>
    <h2>Хранение и удаление</h2>
    <p>Переписка хранится столько, сколько нужно для исполнения заказа и требований законодательства о бухгалтерском учёте. Чтобы уточнить или удалить свои данные, напишите на {SITE.email}.</p>
  </div>
</Page>
