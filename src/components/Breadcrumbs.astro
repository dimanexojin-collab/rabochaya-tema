---
import type { Crumb } from '../lib/schema.ts';
import { url } from '../lib/paths.ts';

interface Props {
  /** Полная цепочка, начиная с главной; href — без base */
  items: Crumb[];
}
const { items } = Astro.props;
---
<nav class="breadcrumbs container" aria-label="Хлебные крошки">
  <ol>
    {items.map((c, i) => (i === items.length - 1 ? <li aria-current="page">{c.name}</li> : <li><a href={url(c.href)}>{c.name}</a></li>))}
  </ol>
</nav>
